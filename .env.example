# Complete Coach - Local Development Environment
# Copy this file to .env.local and update values as needed

# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=
POSTGRES_DB=your_postgres_db
POSTGRES_PORT=5432

# Database URL (used by Prisma and app)
# Set this to your PostgreSQL connection string
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (fill in from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Cloudflare Stream (Video DRM)
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Resend (Email)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Sentry (Error Tracking)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
