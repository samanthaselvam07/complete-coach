# Keep real values in Vercel/CI/local secret stores only.
# Do not commit populated .env files.

# Auth.js
# Generate with: pnpm dlx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Client app production origin:
# NEXTAUTH_URL="https://client.completecoach.fit"

# Public app URL used in transactional email buttons.
COMPLETE_COACH_APP_URL="https://completecoach.fit"

# Neon/PostgreSQL
# Runtime should use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"

# Migrations should use the direct host when available.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Optional local seed account. Do not use shared or production passwords.
DEMO_COACH_EMAIL=""
DEMO_COACH_PASSWORD=""

# Optional local-only auth bypass for UI prototyping. Leave disabled for clean-slate testing.
NEXT_PUBLIC_LOCAL_DEV_AUTH_BYPASS="0"

# Platform admin allowlist for /admin and /api/v1/admin/*.
# Comma-separate multiple emails. Keep this narrow in production.
PLATFORM_ADMIN_EMAILS="sammi@completecoach.fit"

# Optional verbose Prisma logs for local debugging only.
PRISMA_DEBUG_LOGS="0"

# Cloudflare R2 object storage for signed media uploads.
# Required only for upload-url endpoints. Keep real values in secret stores.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Stripe Connect/Billing.
# Required only for payment/package endpoints that call Stripe. Keep real values in secret stores.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend transactional email and delivery webhooks.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_WEBHOOK_SECRET=""

# Sentry error and performance monitoring. Browser DSN may use the same public DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Required only when uploading source maps during builds.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Structured JSON logging.
LOG_LEVEL="info"
