model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id                           String                        @id @default(cuid())
  name                         String?
  email                        String?                       @unique
  emailVerified                DateTime?                     @map("email_verified") @db.Timestamptz(6)
  image                        String?                       @map("image_url")
  passwordHash                 String?                       @map("password_hash")
  authProvider                 String?                       @map("auth_provider")
  authProviderAccountId        String?                       @map("auth_provider_account_id")
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts                     Account[]
  sessions                     Session[]
  memberships                  OrganizationMembership[]      @relation("MembershipUser")
  invitedMemberships           OrganizationMembership[]      @relation("MembershipInviter")
  sentTeamInvitations          TeamInvitation[]               @relation("TeamInvitationInviter")
  auditLogs                    AuditLog[]
  clients                      Client[]                      @relation("ClientPortalUser")
  coachedClients               Client[]                      @relation("ClientPrimaryCoach")
  clientNotes                  ClientNote[]                  @relation("ClientNoteAuthor")
  clientAccountActivityLogs    ClientAccountActivityLog[]    @relation("ClientAccountActivityActor")
  assignedLeads                Lead[]                        @relation("LeadAssignee")
  leadActivities               LeadActivity[]
  createdForms                 Form[]                        @relation("FormCreator")
  createdFormVersions          FormVersion[]                 @relation("FormVersionCreator")
  createdFormAssignments       FormAssignment[]              @relation("FormAssignmentCreator")
  submittedForms               FormSubmission[]              @relation("FormSubmissionSubmitter")
  reviewedFormSubmissions      FormSubmission[]              @relation("FormSubmissionReviewer")
  reviewedCheckIns             CheckIn[]                     @relation("CheckInReviewer")
  createdExercises             ExerciseLibraryItem[]         @relation("ExerciseCreator")
  createdFoods                 FoodLibraryItem[]             @relation("FoodCreator")
  createdTrainingTemplates     TrainingProgramTemplate[]     @relation("TrainingTemplateCreator")
  createdTrainingAssignments   TrainingProgramAssignment[]   @relation("TrainingAssignmentCreator")
  createdMealPlanTemplates     MealPlanTemplate[]            @relation("MealPlanTemplateCreator")
  createdMealPlanAssignments   MealPlanAssignment[]          @relation("MealPlanAssignmentCreator")
  createdSupplementItems       SupplementLibraryItem[]       @relation("SupplementCreator")
  createdSupplementCoachDetails SupplementCoachDetail[]       @relation("SupplementCoachDetailCreator")
  updatedSupplementCoachDetails SupplementCoachDetail[]       @relation("SupplementCoachDetailUpdater")
  createdSupplementTemplates   SupplementPlanTemplate[]      @relation("SupplementTemplateCreator")
  createdSupplementAssignments SupplementPlanAssignment[]    @relation("SupplementAssignmentCreator")
  createdEducationResources    EducationResource[]           @relation("EducationResourceCreator")
  assignedEducationResources   EducationResourceAssignment[] @relation("EducationResourceAssigner")
  sentMessages                 Message[]                     @relation("MessageSenderUser")
  messageReceipts              MessageReceipt[]              @relation("MessageReceiptUser")
  userNotifications            Notification[]                @relation("NotificationRecipientUser")
  assignedTasks                Task[]                        @relation("TaskAssignedUser")
  createdTasks                 Task[]                        @relation("TaskCreator")
  createdPackages              CoachingPackage[]             @relation("PackageCreator")
  createdSenderDomains         OrganizationSenderDomain[]    @relation("OrganizationSenderDomainCreator")
  socialConnections            SocialConnection[]            @relation("SocialConnectionCreator")
  socialOAuthStates            SocialOAuthState[]            @relation("SocialOAuthStateCreator")
  calendarConnections          CalendarConnection[]          @relation("CalendarConnectionCreator")
  calendarOAuthStates          CalendarOAuthState[]          @relation("CalendarOAuthStateCreator")
  createdSocialPosts           SocialPost[]                  @relation("SocialPostCreator")
  createdAiPromptVersions      AiPromptVersion[]             @relation("AiPromptVersionCreator")
  createdAiMethodologyProfiles AiMethodologyProfile[]        @relation("AiMethodologyProfileCreator")
  requestedAiGenerations       AiGeneration[]                @relation("AiGenerationRequester")
  approvedAiOutputs            AiOutput[]                    @relation("AiOutputApprover")
  rejectedAiOutputs            AiOutput[]                    @relation("AiOutputRejecter")
  coachProfiles                CoachProfile[]

  @@unique([authProvider, authProviderAccountId])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id                           String                        @id @default(cuid())
  name                         String
  slug                         String                        @unique
  status                       OrganizationStatus            @default(ACTIVE)
  timezone                     String                        @default("UTC")
  stripeConnectAccountId       String?                       @map("stripe_connect_account_id")
  stripeConnectStatus          String?                       @map("stripe_connect_status")
  platformPlan                 String?                       @map("platform_plan")
  platformStripeCustomerId      String?                       @map("platform_stripe_customer_id")
  platformStripeSubscriptionId  String?                       @map("platform_stripe_subscription_id")
  platformSubscriptionStatus    String?                       @map("platform_subscription_status")
  platformCurrentPeriodStart    DateTime?                     @map("platform_current_period_start") @db.Timestamptz(6)
  platformCurrentPeriodEnd      DateTime?                     @map("platform_current_period_end") @db.Timestamptz(6)
  platformCancelAt             DateTime?                     @map("platform_cancel_at") @db.Timestamptz(6)
  founderOnboardingRequired    Boolean                       @default(false) @map("founder_onboarding_required")
  founderOnboardingCompletedAt DateTime?                     @map("founder_onboarding_completed_at") @db.Timestamptz(6)
  founderOnboardingFocus       String?                       @map("founder_onboarding_focus")
  founderOnboardingRosterSize  String?                       @map("founder_onboarding_roster_size")
  founderOnboardingPlatform    String?                       @map("founder_onboarding_platform")
  founderOnboardingOtherPlatform String?                     @map("founder_onboarding_other_platform")
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                    DateTime?                     @map("deleted_at") @db.Timestamptz(6)
  memberships                  OrganizationMembership[]
  teamInvitations              TeamInvitation[]
  auditLogs                    AuditLog[]
  clients                      Client[]
  clientProfiles               ClientProfile[]
  leads                        Lead[]
  leadActivities               LeadActivity[]
  crmStages                    CrmStage[]
  forms                        Form[]
  formVersions                 FormVersion[]
  formAssignments              FormAssignment[]
  formSubmissions              FormSubmission[]
  checkIns                     CheckIn[]
  clientMeasurements           ClientMeasurement[]
  clientActivityLogs           ClientActivityLog[]
  clientWorkoutSessions        ClientWorkoutSession[]
  clientAccountActivityLogs    ClientAccountActivityLog[]
  clientGoals                  ClientGoal[]
  externalApiKeys              ExternalApiKey[]
  externalExportJobs           ExternalExportJob[]
  externalWebhookEndpoints     ExternalWebhookEndpoint[]
  externalWebhookDeliveries    ExternalWebhookDelivery[]
  exerciseLibraryItems         ExerciseLibraryItem[]
  foodLibraryItems             FoodLibraryItem[]
  trainingProgramTemplates     TrainingProgramTemplate[]
  trainingProgramAssignments   TrainingProgramAssignment[]
  mealPlanTemplates            MealPlanTemplate[]
  mealPlanAssignments          MealPlanAssignment[]
  supplementLibraryItems       SupplementLibraryItem[]
  supplementCoachDetails       SupplementCoachDetail[]
  supplementPlanTemplates      SupplementPlanTemplate[]
  supplementPlanAssignments    SupplementPlanAssignment[]
  educationResources           EducationResource[]
  educationResourceAssignments EducationResourceAssignment[]
  conversations                Conversation[]
  messages                     Message[]
  messageAttachments           MessageAttachment[]
  messageReceipts              MessageReceipt[]
  notifications                Notification[]
  tasks                        Task[]
  emailDeliveries              EmailDelivery[]
  senderDomains                OrganizationSenderDomain[]
  packages                     CoachingPackage[]
  clientSubscriptions          ClientSubscription[]
  paymentEvents                PaymentEvent[]
  socialConnections            SocialConnection[]
  socialOAuthStates            SocialOAuthState[]
  calendarConnections          CalendarConnection[]
  calendarOAuthStates          CalendarOAuthState[]
  socialPosts                  SocialPost[]
  socialPostTargets            SocialPostTarget[]
  socialPostAttempts           SocialPostAttempt[]
  socialAnalyticsSnapshots     SocialAnalyticsSnapshot[]
  aiPromptVersions             AiPromptVersion[]
  aiMethodologyProfiles        AiMethodologyProfile[]
  aiGenerations                AiGeneration[]
  aiOutputs                    AiOutput[]
  clientNotes                  ClientNote[]
  clientRoadmapPhases          ClientRoadmapPhase[]
  clientRoadmapItems           ClientRoadmapItem[]
  clientCalendarEvents         ClientCalendarEvent[]
  coachProfiles                CoachProfile[]

  @@index([status])
  @@index([platformPlan])
  @@index([platformSubscriptionStatus])
  @@unique([platformStripeCustomerId])
  @@unique([platformStripeSubscriptionId])
  @@index([founderOnboardingRequired, founderOnboardingCompletedAt])
  @@map("organizations")
}

model OrganizationSenderDomain {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  domain           String
  provider         String       @default("resend")
  providerDomainId String?      @map("provider_domain_id")
  status           String       @default("not_started")
  fromLocalPart    String       @default("hello") @map("from_local_part")
  senderName       String       @map("sender_name")
  recordsJson      Json?        @map("records_json")
  verifiedAt       DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdByUserId  String?      @map("created_by_user_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("OrganizationSenderDomainCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, domain])
  @@index([organizationId, status])
  @@index([providerDomainId])
  @@index([createdByUserId])
  @@map("organization_sender_domains")
}

model CoachProfile {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  userId            String       @map("user_id")
  professionalTitle String?      @map("professional_title")
  phone             String?
  photoFileName     String?      @map("photo_file_name")
  bio               String?      @db.Text
  philosophy        String?      @db.Text
  specialitiesJson  Json?        @map("specialities_json")
  credentialsJson   Json?        @map("credentials_json")
  clientCapacityLimit Int?       @map("client_capacity_limit")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("coach_profiles")
}

model OrganizationMembership {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  userId          String           @map("user_id")
  role            MembershipRole
  status          MembershipStatus @default(INVITED)
  invitedByUserId String?          @map("invited_by_user_id")
  joinedAt        DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy       User?            @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId, status])
  @@index([invitedByUserId])
  @@map("organization_memberships")
}

model TeamInvitation {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  email           String
  role            MembershipRole
  status          TeamInvitationStatus @default(PENDING)
  tokenHash       String               @unique @map("token_hash")
  invitedByUserId String?              @map("invited_by_user_id")
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?            @map("accepted_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
